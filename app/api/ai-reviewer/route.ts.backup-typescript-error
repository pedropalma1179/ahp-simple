async function generateReview(data: ReviewRequest, classification: any): Promise<string> {
  const client = new Anthropic({
    apiKey: process.env.ANTHROPIC_API_KEY,
  });

  const knowledgeContext = getKnowledgeContext();
  const criticalRefs = getCriticalRefs();
  const crRefs = getRefsByTopic('consistência');
  const bocrRefs = getRefsByTopic('BOCR');
  const sensibilityRefs = getRefsByTopic('sensibilidade');
  
  // Análise de respondentes individuais
  let respondentAnalysis = '';
  let respondentSummary = '';
  
  if (data.qualityAnalysis?.respondents) {
    const critical = data.qualityAnalysis.respondents.filter(r => r.status === 'CRÍTICO');
    const suspicious = data.qualityAnalysis.respondents.filter(r => r.status === 'SUSPEITO');
    const ok = data.qualityAnalysis.respondents.filter(r => r.status === 'OK');
    
    respondentSummary = `
**Distribuição de Qualidade dos Respondentes:**
- Total: ${data.qualityAnalysis.summary.total} especialistas
- Respostas confiáveis (CR ≤ 0.10): ${ok.length} (${((ok.length / data.qualityAnalysis.summary.total) * 100).toFixed(1)}%)
- Respostas suspeitas (0.10 < CR ≤ 0.20): ${suspicious.length} (${((suspicious.length / data.qualityAnalysis.summary.total) * 100).toFixed(1)}%)
- Respostas críticas (CR > 0.20): ${critical.length} (${((critical.length / data.qualityAnalysis.summary.total) * 100).toFixed(1)}%)
`;

    if (critical.length > 0) {
      respondentAnalysis += `\n**Respondentes com Inconsistência Crítica (CR > 0.20):**\n`;
      critical.slice(0, 10).forEach(r => {
        respondentAnalysis += `- ${r.name || 'ID: ' + r.id}: CR médio = ${(r.avgCR * 100).toFixed(1)}%\n`;
      });
      if (critical.length > 10) {
        respondentAnalysis += `... e mais ${critical.length - 10} respondentes críticos\n`;
      }
    }
  }
  
  // Calcular métricas agregadas
  const totalResponses = data.individualStats.Benefits.total + 
                        data.individualStats.Opportunities.total +
                        data.individualStats.Costs.total +
                        data.individualStats.Risks.total;
                        
  const validResponses = data.individualStats.Benefits.valid + 
                        data.individualStats.Opportunities.valid +
                        data.individualStats.Costs.valid +
                        data.individualStats.Risks.valid;
                        
  const overallValidPercent = totalResponses > 0 ? (validResponses / totalResponses) * 100 : 0;
  
  const userPrompt = `
# MANUSCRITO SUBMETIDO

**Título do Projeto:** ${data.projectName}
${data.projectDescription ? `\n**Descrição:** ${data.projectDescription}\n` : ''}

**Classificação Preliminar (Sistema Automatizado):**
- Pontuação: ${classification.score}/100
- Recomendação: ${classification.veredicto}

---

# DADOS METODOLÓGICOS COLETADOS

## Amostra e Qualidade Geral

${respondentSummary}

**Taxa de Validade Geral:** ${overallValidPercent.toFixed(1)}% das respostas com CR ≤ 0.10

${respondentAnalysis}

## Estatísticas por Dimensão BOCR

### Benefits (Benefícios)
- Respostas totais: ${data.individualStats.Benefits.total}
- Válidas (CR ≤ 0.10): ${data.individualStats.Benefits.valid} (${data.individualStats.Benefits.total > 0 ? ((data.individualStats.Benefits.valid / data.individualStats.Benefits.total) * 100).toFixed(1) : 0}%)
- Warning (0.10 < CR ≤ 0.20): ${data.individualStats.Benefits.warning}
- Críticas (CR > 0.20): ${data.individualStats.Benefits.critical}
${data.individualStats.Benefits.avgCR ? `- CR médio da dimensão: ${(data.individualStats.Benefits.avgCR * 100).toFixed(2)}%` : ''}

### Opportunities (Oportunidades)
