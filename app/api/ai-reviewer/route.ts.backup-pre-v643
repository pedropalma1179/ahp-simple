// app/api/ai-reviewer/route.ts
// API de Revisão IA v6.4.2-DEBUG
// Versão de debug para ver exatamente o que o frontend envia

import { NextRequest, NextResponse } from 'next/server';
import { getKnowledgeStats } from './knowledge';

export async function GET() {
  const stats = getKnowledgeStats();
  
  return NextResponse.json({
    name: 'AI Reviewer API',
    version: '6.4.2-debug',
    description: 'Debug version - mostra payload completo',
    knowledgeBase: {
      totalRefs: stats.totalRefs,
      uniqueArticles: stats.uniqueArticles,
    },
  });
}

export async function POST(request: NextRequest) {
  try {
    const rawData = await request.json();
    
    // Log completo do payload
    console.log('═══════════════════════════════════════════════════════');
    console.log('[DEBUG] PAYLOAD COMPLETO RECEBIDO:');
    console.log(JSON.stringify(rawData, null, 2));
    console.log('═══════════════════════════════════════════════════════');
    console.log('[DEBUG] Chaves do objeto:', Object.keys(rawData));
    console.log('═══════════════════════════════════════════════════════');
    
    // Verificar cada campo importante
    if (rawData.individualStats) {
      console.log('[DEBUG] individualStats encontrado:');
      console.log(JSON.stringify(rawData.individualStats, null, 2));
    }
    
    if (rawData.qualityAnalysis) {
      console.log('[DEBUG] qualityAnalysis encontrado:');
      console.log(JSON.stringify(rawData.qualityAnalysis, null, 2));
    }
    
    if (rawData.respondents) {
      console.log('[DEBUG] respondents encontrado:', rawData.respondents.length, 'respondentes');
      console.log('[DEBUG] Primeiro respondente:', JSON.stringify(rawData.respondents[0], null, 2));
    }
    
    if (rawData.bocrWeights || rawData.weights) {
      console.log('[DEBUG] Pesos BOCR encontrados:');
      console.log(JSON.stringify(rawData.bocrWeights || rawData.weights, null, 2));
    }
    
    // Retornar análise mockada para debug
    return NextResponse.json({
      success: true,
      debug: true,
      message: 'Payload recebido com sucesso! Verifique os logs do Vercel.',
      payloadKeys: Object.keys(rawData),
      hasIndividualStats: !!rawData.individualStats,
      hasQualityAnalysis: !!rawData.qualityAnalysis,
      hasRespondents: !!rawData.respondents,
      hasBocrWeights: !!(rawData.bocrWeights || rawData.weights),
      review: '## 🐛 DEBUG MODE\n\nPayload recebido com sucesso! Verifique os logs do Vercel para ver o formato completo.',
      nota: 'DEBUG',
      veredicto: 'DEBUG MODE - Verifique logs',
      metadata: {
        version: '6.4.2-debug',
        timestamp: new Date().toISOString(),
      },
    });

  } catch (error: any) {
    console.error('[DEBUG] ERRO:', error);
    return NextResponse.json(
      { 
        error: 'Erro ao processar',
        details: error.message,
        stack: error.stack,
      },
      { status: 500 }
    );
  }
}
