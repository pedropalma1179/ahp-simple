// ============================================================
// 4. SUBSTITUIR BLOCOS
// ============================================================

function replaceBlocks(text: string, blocks: Record<string, string>): string {
  let result = text;
  
  // Ordenar por tamanho (maior primeiro) para evitar substituições parciais
  const sortedBlocks = Object.entries(blocks).sort((a, b) => b[0].length - a[0].length);
  
  for (const [block, content] of sortedBlocks) {
    result = result.split(block).join(content);
  }
  
  return result;
}

// ============================================================
// 5. API ENDPOINT
// ============================================================

export async function POST(request: NextRequest) {
  try {
    const { calculationData, projectName } = await request.json();

    if (!calculationData) {
      return NextResponse.json({ error: 'calculationData é obrigatório' }, { status: 400 });
    }

    // 1. JavaScript escreve a verdade (Blocos Narrativos)
    const truth = calculateNarrativeBlocks(calculationData);

    // 2. Preparar prompt (com Certificado de Auditoria)
    const userPrompt = prepareUserPrompt(calculationData, truth, projectName);

    // 3. Chamar Claude API
    const message = await anthropic.messages.create({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 4096,
      messages: [{ role: 'user', content: userPrompt }],
      system: SYSTEM_PROMPT
    });

    // 4. Extrair resposta
    let responseText = message.content[0].type === 'text' 
      ? message.content[0].text 
      : '';

    // 5. A MÁGICA: Substituir TODOS os blocos pelos textos reais
    responseText = replaceBlocks(responseText, truth.blocks);

    // 6. Parsear JSON
    let parsedReview;
    try {
      // Limpar markdown
      const cleanedResponse = responseText
        .replace(/```json\s*/gi, '')
        .replace(/```\s*/g, '')
        .trim();
      
      const jsonMatch = cleanedResponse.match(/\{[\s\S]*\}/);
      if (jsonMatch) {
        parsedReview = JSON.parse(jsonMatch[0]);
        
        // Adicionar metadados oficiais
        parsedReview._valores_oficiais = truth.meta;
        parsedReview._versao = '5.2-normalizado';
        
      } else {
        parsedReview = { 
          raw_response: responseText,
          _valores_oficiais: truth.meta
        };
      }
    } catch (e) {
      parsedReview = { 
        raw_response: responseText, 
        parse_error: true,
        _valores_oficiais: truth.meta
      };
    }

    return NextResponse.json({
      success: true,
      review: parsedReview,
      metadata: {
        model: 'claude-sonnet-4-20250514',
        timestamp: new Date().toISOString(),
        tokens_used: message.usage?.output_tokens || 0,
        versao: '5.2-normalizado',
        valores_oficiais: truth.meta
      }
    });

  } catch (error) {
    console.error('Erro na revisão por IA:', error);
    return NextResponse.json({ 
      error: 'Erro ao executar revisão por IA',
      details: error instanceof Error ? error.message : 'Unknown error'
    }, { status: 500 });
  }
}

