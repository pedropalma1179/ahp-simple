// ============================================================
// INTERFACES
// ============================================================

interface NarrativeBlocks {
  blocks: Record<string, string>;
  meta: {
    cr: string;
    diff: string;
    concordancia: string;
    vencedor: string;
    segundo: string;
    amostra: number;
    isUnanimous: boolean;
    sensibilidadeStatus: string;
  };
}

// ============================================================
// 1. CÁLCULO DA VERDADE & REDAÇÃO DOS BLOCOS
// ============================================================

// Função de normalização para comparação segura de strings
const normalize = (s: string): string => (s || '').trim().toLowerCase();

function calculateNarrativeBlocks(calculationData: any): NarrativeBlocks {
  const {
    bocrWeights = [],
    bocrConsistency = {},
    finalScores = [],
    responseCount = 0,
    sensitivityInflections = {}
  } = calculationData;

  // --- VENCEDORES POR MÉTODO ---
  const getWinner = (field: string): string => {
    const sorted = [...finalScores].sort((a: any, b: any) => (b[field] || 0) - (a[field] || 0));
    return sorted[0]?.name || 'N/A';
  };

  const sortedByAdditive = [...finalScores].sort((a: any, b: any) => 
    (b.scoreAdditive || 0) - (a.scoreAdditive || 0)
  );
  
  const winnerName = sortedByAdditive[0]?.name || 'N/A';
  const runnerUpName = sortedByAdditive[1]?.name || 'N/A';

  // --- CONCORDÂNCIA (com normalização para evitar problemas de comparação) ---
  const methods = ['scoreAdditive', 'scoreProbabilistic', 'scoreSubtractiveNorm', 'scoreMultPowersNorm', 'scoreMultSimpleNorm'];
  const winners = methods.map(m => getWinner(m));
  
  // Comparação normalizada para evitar problemas de espaços/maiúsculas
  const concordanciaCount = winners.filter(w => normalize(w) === normalize(winnerName)).length;
  const isUnanimous = concordanciaCount === 5;
  
  // Debug: log para verificar a comparação (pode ser removido em produção)
  console.log('[AI-Review] Concordância:', {
    winnerName,
    winners,
    concordanciaCount,
    isUnanimous,
    normalized: winners.map(w => `${w} -> ${normalize(w)}`)
  });

  // --- VALORES NUMÉRICOS ---
  const crVal = ((bocrConsistency.cr || 0) * 100).toFixed(2);
  const score1 = sortedByAdditive[0]?.scoreAdditive || 0;
  const score2 = sortedByAdditive[1]?.scoreAdditive || 0;
  const diffVal = (Math.abs(score1 - score2) * 100).toFixed(2);
  const diffNum = parseFloat(diffVal);

  // --- B+O e C+R ---
  const boSum = ((bocrWeights[0] || 0) + (bocrWeights[1] || 0)) * 100;
  const crSum = ((bocrWeights[2] || 0) + (bocrWeights[3] || 0)) * 100;

  // --- SENSIBILIDADE ---
  const meritNames: Record<string, string> = { B: 'Benefícios', O: 'Oportunidades', C: 'Custos', R: 'Riscos' };
  const criticos: string[] = [];
  const sensiveis: string[] = [];
  
  Object.entries(sensitivityInflections).forEach(([key, val]: [string, any]) => {
    if (val !== null && val !== undefined) {
      if (val <= 10) criticos.push(`${meritNames[key]} (${val}%)`);
      else if (val <= 20) sensiveis.push(`${meritNames[key]} (${val}%)`);
    }
  });

  // ============================================================
  // REDAÇÃO DETERMINÍSTICA DOS BLOCOS
  // O JavaScript escreve a verdade. A IA não pode modificar.
  // ============================================================

  // BLOCO 1: Concordância
  const BLOCO_CONCORDANCIA = isUnanimous
    ? `Convergência metodológica UNÂNIME: todos os 5 métodos de síntese confirmam ${winnerName} como vencedor.`
    : `Convergência PREDOMINANTE: ${concordanciaCount} de 5 métodos indicam ${winnerName} como vencedor (divergência em ${5 - concordanciaCount} método${5 - concordanciaCount > 1 ? 's' : ''}).`;

  // BLOCO 2: Consistência (CR) - NUNCA confundir com diferença
  const crNum = parseFloat(crVal);
  let BLOCO_CR = '';
  if (crNum <= 5) {
    BLOCO_CR = `Consistência EXCELENTE: CR = ${crVal}% (muito abaixo do limite de 10%).`;
  } else if (crNum <= 10) {
    BLOCO_CR = `Consistência ACEITÁVEL: CR = ${crVal}% (dentro do limite de 10%).`;
  } else {
    BLOCO_CR = `INCONSISTÊNCIA DETECTADA: CR = ${crVal}% (acima do limite de 10%). Revisar julgamentos.`;
  }

  // BLOCO 3: Diferença - NUNCA confundir com CR
  let BLOCO_DIFERENCA = '';
  if (diffNum < 2) {
    BLOCO_DIFERENCA = `EMPATE TÉCNICO: diferença de apenas ${diffVal}% entre ${winnerName} e ${runnerUpName} (estatisticamente equivalentes).`;
  } else if (diffNum < 5) {
    BLOCO_DIFERENCA = `Diferença MARGINAL: ${diffVal}% entre ${winnerName} e ${runnerUpName} (requer análise de desempate).`;
  } else if (diffNum < 10) {
    BLOCO_DIFERENCA = `Diferença MODERADA: ${diffVal}% entre ${winnerName} e ${runnerUpName}.`;
  } else if (diffNum < 20) {
    BLOCO_DIFERENCA = `Diferença EXPRESSIVA: ${diffVal}% entre ${winnerName} e ${runnerUpName} (dominância clara).`;
  } else {
    BLOCO_DIFERENCA = `DOMINÂNCIA ABSOLUTA: ${diffVal}% de diferença entre ${winnerName} e ${runnerUpName}.`;
  }

  // BLOCO 4: Amostra
  let BLOCO_AMOSTRA = '';
  if (responseCount >= 30) {
    BLOCO_AMOSTRA = `Amostra EXCELENTE: n = ${responseCount} especialistas (adequada para qualquer periódico).`;
  } else if (responseCount >= 15) {
    BLOCO_AMOSTRA = `Amostra ADEQUADA: n = ${responseCount} especialistas.`;
  } else if (responseCount >= 7) {
    BLOCO_AMOSTRA = `Amostra MÍNIMA: n = ${responseCount} especialistas (recomenda-se ampliação).`;
  } else {
    BLOCO_AMOSTRA = `Amostra INSUFICIENTE: n = ${responseCount} especialistas (necessária ampliação).`;
  }

  // BLOCO 5: Sensibilidade
  let BLOCO_SENSIBILIDADE = '';
  let sensibilidadeStatus = 'ROBUSTO';
  if (criticos.length > 0) {
    BLOCO_SENSIBILIDADE = `Sensibilidade CRÍTICA: ranking inverte com variação ≤10% em ${criticos.join(', ')}.`;
    sensibilidadeStatus = 'CRÍTICO';
  } else if (sensiveis.length > 0) {
    BLOCO_SENSIBILIDADE = `Sensibilidade MODERADA: ranking inverte com variação de 10-20% em ${sensiveis.join(', ')}.`;
    sensibilidadeStatus = 'SENSÍVEL';
  } else {
    BLOCO_SENSIBILIDADE = `Resultado ROBUSTO: ranking estável mesmo com variações de ±20% nos pesos BOCR.`;
  }

  // BLOCO 6: Viés
  let BLOCO_VIES = '';
  if (boSum > 60) {
    BLOCO_VIES = `Viés OTIMISTA detectado: ${boSum.toFixed(1)}% do peso em aspectos positivos (B+O).`;
  } else if (crSum > 60) {
    BLOCO_VIES = `Viés CONSERVADOR detectado: ${crSum.toFixed(1)}% do peso em aspectos negativos (C+R).`;
  } else {
    BLOCO_VIES = `Perfil BALANCEADO: ${boSum.toFixed(1)}% em B+O vs ${crSum.toFixed(1)}% em C+R.`;
  }

  // BLOCO 7: Resumo Executivo (frase pronta para o início)
  const BLOCO_RESUMO = `${winnerName} é a alternativa recomendada com ${BLOCO_DIFERENCA.toLowerCase()} ${BLOCO_CONCORDANCIA.toLowerCase()} ${BLOCO_CR.toLowerCase()}`;

  // BLOCO 8: Vencedor e Segundo (simples)
  const BLOCO_VENCEDOR = winnerName;
  const BLOCO_SEGUNDO = runnerUpName;

  return {
    blocks: {
      "{{BLOCO_CONCORDANCIA}}": BLOCO_CONCORDANCIA,
      "{{BLOCO_CR}}": BLOCO_CR,
      "{{BLOCO_DIFERENCA}}": BLOCO_DIFERENCA,
      "{{BLOCO_AMOSTRA}}": BLOCO_AMOSTRA,
      "{{BLOCO_SENSIBILIDADE}}": BLOCO_SENSIBILIDADE,
      "{{BLOCO_VIES}}": BLOCO_VIES,
      "{{BLOCO_RESUMO}}": BLOCO_RESUMO,
      "{{VENCEDOR}}": BLOCO_VENCEDOR,
      "{{SEGUNDO}}": BLOCO_SEGUNDO,
      // Valores isolados (backup)
      "{{CONCORDANCIA_SCORE}}": `${concordanciaCount}/5`,
      "{{CR_VALUE}}": `${crVal}%`,
      "{{DIFF_VALUE}}": `${diffVal}%`,
      "{{AMOSTRA_N}}": `${responseCount}`
    },
    meta: {
      cr: `${crVal}%`,
      diff: `${diffVal}%`,
      concordancia: `${concordanciaCount}/5`,
      vencedor: winnerName,
      segundo: runnerUpName,
      amostra: responseCount,
      isUnanimous,
      sensibilidadeStatus
    }
  };
}

