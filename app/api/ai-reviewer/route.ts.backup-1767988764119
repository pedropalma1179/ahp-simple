import { NextRequest, NextResponse } from 'next/server';
import Anthropic from '@anthropic-ai/sdk';

// ============================================================
// TIPOS E INTERFACES
// ============================================================

interface IndividualStats {
  total: number;
  valid: number;      // CONFIÁVEL
  warning: number;    // REVISAR + SUSPEITO
  critical: number;   // CRÍTICO
  avgCR?: number;     // CR médio individual
}

interface ReviewRequest {
  projectName: string;
  projectDescription?: string;
  alternatives: Array<{ code: string; name: string; description?: string }>;
  bocrWeights: number[];
  bocrConsistency: { cr: number; lambda: number; ci?: number };
  subWeights: Record<string, number[]>;
  subConsistency: Record<string, { cr: number; lambda: number }>;
  finalScores: Array<{
    name: string;
    code: string;
    scoreAdditive?: number;
    scoreMultiplicative?: number;
    rankAdditive?: number;
    rankMultiplicative?: number;
    B?: number;
    O?: number;
    C?: number;
    R?: number;
  }>;
  responseCount: number;
  sensitivityInflections?: Record<string, number | null>;
  // NOVO v6.0: Estatísticas individuais dos respondentes
  individualStats?: IndividualStats;
}

interface ClassificationResult {
  grade: 'A' | 'B' | 'C';
  gradeLabel: string;
  verdict: string;
  verdictIcon: string;
  confidenceLevel: string;
  qualityPenalty: boolean;
  penaltyReason?: string;
}

interface NarrativeBlocks {
  BLOCO_CONSISTENCIA: string;
  BLOCO_RANKING: string;
  BLOCO_SENSIBILIDADE: string;
  BLOCO_AMOSTRA: string;
  BLOCO_QUALIDADE: string;      // NOVO v6.0
  BLOCO_CLASSIFICACAO: string;  // NOVO v6.0
  BLOCO_VEREDITO: string;       // NOVO v6.0
  tokens: Record<string, string>;
}

// ============================================================
// CONSTANTES DE CONFIGURAÇÃO
// ============================================================

const THRESHOLDS = {
  CR_EXCELLENT: 0.05,
  CR_GOOD: 0.08,
  CR_ACCEPTABLE: 0.10,
  CR_WARNING: 0.15,
  CR_CRITICAL: 0.20,
  MIN_RESPONDENTS: 5,
  IDEAL_RESPONDENTS: 7,
  // NOVO v6.0: Limites do Quality Gate
  QUALITY_GATE_WARNING: 0.20,   // 20% de respondentes ruins = alerta
  QUALITY_GATE_CRITICAL: 0.30,  // 30% de respondentes ruins = penalidade
  QUALITY_GATE_SEVERE: 0.50,    // 50% de respondentes ruins = penalidade grave
};

