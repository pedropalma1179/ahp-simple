      variables.forEach(v => {
        demoData.push([v.title]);
        demoData.push(['Categoria', 'n', '%']);
        const counts = countField(v.field, v.map);
        counts.forEach(c => {
          demoData.push([c.label, c.count.toString(), `${c.pct}%`]);
