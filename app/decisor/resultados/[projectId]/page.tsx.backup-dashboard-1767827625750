        ['11_20', '21_30', 'mais_30'].includes(d.tempoTrabalho)
      ).length;
      const gestores = respondentsDemographics.filter(d => 
        ['c_level', 'diretor', 'gerente'].includes(d.funcao)
      ).length;

      demoData.push(['QUALIFICAÇÃO DA AMOSTRA']);
