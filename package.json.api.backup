{
  "name": "ahp-bocr-peer-review-api",
  "version": "6.5.1",
  "description": "Complete AHP-BOCR manuscript validation system with benchmarks from 961 citations",
  "type": "module",
  "main": "bocr-peer-review-api.ts",
  "scripts": {
    "demo": "ts-node --esm demo.ts",
    "test": "ts-node --esm bocr-peer-review-api.ts"
  },
  "keywords": [
    "AHP",
    "BOCR",
    "Multi-criteria decision making",
    "MCDM",
    "Peer review",
    "Academic validation"
  ],
  "author": "Research Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "knowledge-base",
    "sources": [
      "Wijnmalen (2007) - 119 citations",
      "Demirtas & Ustun (2008) - 310 citations",
      "Lee (2009) - 305 citations",
      "Lee et al. (2009) - 232 citations",
      "Petrillo et al. (2023) - Review of 181 papers"
    ]
  }
}
